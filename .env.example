APP_NAME=Menu QR AI
APP_URL=http://127.0.0.1:8000
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=sqlite:///./menu.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=1
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Uvicorn trusts forwarded headers only from these direct peers.
# Render supplies "*" because its application port is not public.
FORWARDED_ALLOW_IPS=127.0.0.1
SESSION_MAX_AGE_SECONDS=43200
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# Public menu analytics, per client IP. Keep it generous: one restaurant WiFi
# shares a single IP across every customer.
ANALYTICS_RATE_LIMIT_EVENTS=300
ANALYTICS_RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO
